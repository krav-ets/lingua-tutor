{
  "name": "lingua-tutor",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "description": "",
  "author": "",
  "license": "MIT",
  "imports": {
    "#root/*": "./build/src/*"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc",
    "build": "tsc --noEmit false",
    "dev": "tsc-watch --onSuccess \"tsx ./src/main.ts\"",
    "start": "tsc && tsx ./src/main.ts",
    "start:force": "tsx ./src/main.ts",
    "test": "vitest",
    "prepare": "husky || true",
    "worker:start": "node --enable-source-maps build/src/worker/index.js"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@grammyjs/auto-chat-action": "^0.1.1",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/parse-mode": "^2.2.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/types": "^3.22.2",
    "@prisma/client": "^6.19.1",
    "@valibot/to-json-schema": "^1.5.0",
    "callback-data": "^1.1.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.6.2",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0",
    "grammy": "^1.38.4",
    "grammy-guard": "^0.5.0",
    "graphile-worker": "^0.16.6",
    "handlebars": "^4.7.8",
    "iso-639-1": "^3.1.5",
    "openai": "^6.15.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prisma": "^6.19.1",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.ts": "eslint"
  }
}

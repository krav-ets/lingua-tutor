{
  "name": "lingua-tutor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "imports": {
    "#root/*": "./build/src/*"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"

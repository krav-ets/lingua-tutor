:80 {
  redir https://{host}{uri} permanent
}

{$DOMAIN}:443 {


  encode gzip zstd

  log {
    level INFO
    output file {$LOG_FILE} {
      roll_size 10MB
      roll_keep 10
    }
  }

  header {
  # Prevent search engines from indexing
  X-Robots-Tag "none"

  # Remove Caddy branding
  -Server
  }

  tls {$EMAIL}

  reverse_proxy app:{$SERVER_PORT} {
       header_up X-Real-IP {remote_host}
  }
}
